# Application Configuration
APP_ENV=development
DEBUG=True
PORT=5000

# AI/ML Configuration
AI_PROVIDER=openai  # Options: openai, anthropic, custom
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here

# Contract Intelligence Settings
COMPLIANCE_THRESHOLD=0.85
DISPUTED_CLAUSE_SENSITIVITY=0.75
MIN_CONFIDENCE_SCORE=0.70

# Document Processing
OCR_ENGINE=tesseract  # Options: tesseract, paddleocr, aws-textract
DOC_MAX_SIZE_MB=50
SUPPORTED_FORMATS=pdf,docx,txt,jpg,png

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/contract_intelligence
DB_POOL_SIZE=10

# Lost Opportunity Analysis
OPPORTUNITY_ANALYSIS_AUTO_RUN=True
ANALYSIS_SCHEDULE=daily  # Options: immediate, daily, weekly

# Security
JWT_SECRET_KEY=your_secret_key_here
ALLOWED_ORIGINS=http://localhost:3000

# File Storage
STORAGE_TYPE=local  # Options: local, s3, gcs
STORAGE_PATH=./data/uploads

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Audit and Compliance
AUDIT_LOGGING_ENABLED=True
KEEP_AUDIT_LOGS_DAYS=730
